<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSectionMini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/policy_miniapp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/groupMiniPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioMiniBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opt_block" />

            <RadioButton
                android:id="@+id/radioMiniQuota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opt_quota" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edMiniWeekday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quota_weekday"
                android:inputType="number" />

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/edMiniWeekend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quota_weekend"
                android:inputType="number" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tvSectionChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/policy_channels"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/groupChannelsPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioChannelsBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opt_block" />

            <RadioButton
                android:id="@+id/radioChannelsQuota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opt_quota" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edChannelsWeekday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quota_weekday"
                android:inputType="number" />

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/edChannelsWeekend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quota_weekend"
                android:inputType="number" />
        </LinearLayout>

        <EditText
            android:id="@+id/edGrace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/grace_label"
            android:inputType="number" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <EditText
            android:id="@+id/edPassNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pass_new"
            android:inputType="numberPassword" />

        <EditText
            android:id="@+id/edPassNew2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pass_new2"
            android:inputType="numberPassword" />

        <Button
            android:id="@+id/btnChangePass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_pass" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />
    </LinearLayout>
</ScrollView>
